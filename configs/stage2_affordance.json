{
    "models": {
        "denoiser": {
            "name": "ElasticSLatFlowModel",
            "args": {
                "resolution": 64,
                "in_channels": 1,
                "out_channels": 1,
                "model_channels": 768,
                "cond_channels": 768,
                "num_blocks": 12,
                "num_heads": 12,
                "mlp_ratio": 4,
                "patch_size": 2,
                "num_io_res_blocks": 2,
                "io_block_channels": [
                    128
                ],
                "pe_mode": "ape",
                "qk_rms_norm": true,
                "use_fp16": true
            }
        }
    },
    "dataset": {
        "name": "AffordanceDataset",
        "args": {}
    },
    "trainer": {
        "name": "AffordanceFlowTrainer",
        "args": {
            "max_steps": 600000,
            "batch_size_per_gpu": 8,
            "batch_split": 1,
            "num_workers": 8,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 0.0001,
                    "weight_decay": 0.0
                }
            },
            "ema_rate": [
                0.9999
            ],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "elastic": {
                "name": "LinearMemoryController",
                "args": {
                    "target_ratio": 0.75,
                    "max_mem_ratio_start": 0.5
                }
            },
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "save_best_only": false,
            "enable_visualization": false,
            "wandb_sample_count": 8,
            "save_samples_to_disk": false,
            "validation_config": {
                "enabled": true,
                "data_dir": "trellis_data/affogato",
                "batch_size": 8,
                "metric_mode": "max",
                "primary_metric": "avg_iou",
                "manifest": "manifests/affogato_test.txt",
                "steps": 50,
                "cfg_strength": 1.0,
                "noise_scale": 0.1,
                "neg_cond_mode": "zeros"
            },
            "i_log": 1500,
            "i_sample": 10000,
            "i_save": 10000,
            "p_uncond": 0.1,
            "t_schedule": {
                "name": "logitNormal",
                "args": {
                    "mean": 1.0,
                    "std": 1.0
                }
            },
            "sigma_min": 1e-05,
            "noise_scale": 5.0,
            "text_cond_model": "openai/clip-vit-large-patch14",
            "prefetch_data": true,
            "loss_config": {
                "name": "SparseAffordanceLoss",
                "eps": 1e-06,
                "base": "focal",
                "gamma": 2.0,
                "alpha": 0.25,
                "sim_weight": 8.0,
                "iou_weight": 2.0,
                "mae_weight": 2.0
            }
        }
    }
}